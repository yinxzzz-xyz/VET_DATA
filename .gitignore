# Track only the application source tree, tests, and this file.
/*
!/.gitignore
!/requirements.txt
!/VET_DATA.spec
!/vet_data/
!/vet_data/**
!/tests/
!/tests/**

# Never track generated files inside the allowed trees.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build and packaging output
build/
dist/
*.egg-info/
*.spec.bak

# IDE and OS metadata
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime and temporary output
*.tmp
*.temp
*.part
*.log
~$*

# Local configuration generated by the application
map_config.json
